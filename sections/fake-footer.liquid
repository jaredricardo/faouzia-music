    <script type="text/javascript" src="//s3.amazonaws.com/downloads.mailchimp.com/js/mc-validate.js"></script>
    <script type="text/javascript">
      (function($) {
        window.fnames = new Array(); window.ftypes = new Array();
        fnames[0]='EMAIL'; ftypes[0]='email';
        fnames[1]='FNAME'; ftypes[1]='text';
        fnames[2]='LNAME'; ftypes[2]='text';
        fnames[5]='BIRTHDAY'; ftypes[5]='birthday';
        fnames[3]='ADDRESS'; ftypes[3]='address';
        fnames[4]='PHONE'; ftypes[4]='phone';
        fnames[6]='COMPANY'; ftypes[6]='text';
      }(jQuery));
      var $mcj = jQuery.noConflict(true);
    </script>
  </div>
</div>

<script>
  (function() {
    var overlay = document.getElementById('email-signup-modal-overlay');
    var triggers = document.querySelectorAll('[data-open-email-modal]');
    var closeBtn = document.getElementById('email-signup-modal-close');

    function openModal() {
      overlay.removeAttribute('hidden');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      overlay.setAttribute('hidden', '');
      document.body.style.overflow = '';
    }

    triggers.forEach(function(trigger) {
      trigger.addEventListener('click', function(e) {
        e.preventDefault();
        openModal();
      });
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeModal);
    }

    if (overlay) {
      overlay.addEventListener('click', function(e) {
        if (e.target === overlay) {
          closeModal();
        }
      });
    }

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay && !overlay.hasAttribute('hidden')) {
        closeModal();
      }
    });
  })();
</script>

{% schema %}
{
    "name": "Fake Footer",
    "enabled_on": {
        "templates": ["product", "collection", "page", "index", "article", "blog", "404", "cart", "search"]
    },
    "settings": [
        {
            "type": "text",
            "id": "section_anchor_id",
            "label": "Section Anchor ID (optional)"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#FFFFFF"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#FFFFFF"
        },
        {
            "type": "range",
            "id": "padding_y_desktop",
            "label": "Desktop Padding Y (px)",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "default": 40
        },
        {
            "type": "range",
            "id": "padding_y_mobile",
            "label": "Mobile Padding Y (px)",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "default": 20
        },
        {
            "type": "header",
            "content": "Images"
        },
        {
            "type": "image_picker",
            "id": "fake_footer_image_left",
            "label": "Left Image"
        },
        {
            "type": "image_picker",
            "id": "fake_footer_image_right",
            "label": "Right Image"
        }
    ],
    "blocks": [
        {
            "type": "social_link",
            "name": "Social Link",
            "settings": [
                {
                    "type": "select",
                    "id": "social_link",
                    "label": "Platform",
                    "default": "text",
                    "options": [
                        { "value": "text",         "label": "Text / Title" },
                        { "value": "instagram",    "label": "Instagram" },
                        { "value": "tiktok",       "label": "TikTok" },
                        { "value": "apple-music",  "label": "Apple Music" },
                        { "value": "facebook",     "label": "Facebook" },
                        { "value": "spotify",      "label": "Spotify" },
                        { "value": "youtube",      "label": "YouTube" },
                        { "value": "soundcloud",   "label": "SoundCloud" },
                        { "value": "amazon-music", "label": "Amazon Music" },
                        { "value": "x-twitter",    "label": "X (Twitter)" }
                    ]
                },
                {
                    "type": "text",
                    "id": "link_label",
                    "label": "Link Label (used when Text / Title is selected)",
                    "default": "Follow"
                },
                {
                    "type": "url",
                    "id": "url",
                    "label": "Link URL"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Fake Footer"
        }
    ]
}
{% endschema %}