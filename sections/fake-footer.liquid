{% style %}

  [data-section-id="{{ section.id }}"] {
    background-color: {{ section.settings.bg_color }} !important;
    color: {{ section.settings.text_color }} !important;
    padding-top: {{ section.settings.padding_y_desktop }}px;
    padding-bottom: {{ section.settings.padding_y_desktop }}px;
  }

  [data-section-id="{{ section.id }}"] ul li a {
    color: {{ section.settings.text_color }};
  }

  [data-section-id="{{ section.id }}"] ul li a svg,
  [data-section-id="{{ section.id }}"] ul li a svg path {
    fill: {{ section.settings.text_color }};
  }

  @media screen and (max-width: 768px) {
    [data-section-id="{{ section.id }}"] {
      padding-top: {{ section.settings.padding_y_mobile }}px;
      padding-bottom: {{ section.settings.padding_y_mobile }}px;
    }
  }

  [data-section-id="{{ section.id }}"] ul li button.email-modal-trigger {
    color: {{ section.settings.text_color }};
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font: inherit;
    text-decoration: none;
  }

{% endstyle %}

<style>
  .email-signup-modal-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 9999;
  }
  .email-signup-modal-overlay[hidden] {
    display: none;
  }
  .email-signup-modal-container {
    position: relative;
    background: #fff;
    border-radius: 5px;
    padding: 2rem;
    max-width: 500px;
    width: 90%;
    max-height: 90vh;
    overflow-y: auto;
  }
  .email-signup-modal-close {
    position: absolute;
    top: 12px;
    right: 12px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .email-signup-modal-close svg {
    --icon-stroke-width: 1.5px;
    width: 18px;
    height: 18px;
  }
</style>

<section data-section-id="{{ section.id }}" class="section fake-footer" {% if section.settings.section_anchor_id %} id="{{ section.settings.section_anchor_id }}" {% endif %}>
    <div class="fake-footer-inner">
        <div class="col first">
            {% if section.settings.fake_footer_image_left %}
                {{ section.settings.fake_footer_image_left | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 50vw, 100vw', widths: '400,600,800,1000,1200', alt: 'Faouzia' }}
            {% endif %}
        </div>
        <div class="col second">
            <div class="follow-image-container">
                <span>Follow</span>
                {% if section.settings.fake_footer_image_right %}
                    {{ section.settings.fake_footer_image_right | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 50vw, 100vw', widths: '400,600,800,1000,1200', alt: 'Faouzia' }}
                {% endif %}
            </div>
            {% if section.blocks.size > 0 %}
                <ul>
                    {% for block in section.blocks %}   
                        <li>
                            {% if block.settings.social_link == 'text' %}
                                <button type="button" class="email-modal-trigger" data-open-email-modal>
                                    {{ block.settings.link_label }}
                                </button>
                            {% else %}
                                <a href="{{ block.settings.url }}" target="_blank">
                                    {% case block.settings.social_link %}
                                        {% when 'instagram' %}
                                            {% render 'icon-instagram' %}
                                        {% when 'tiktok' %}
                                            {% render 'icon-tiktok' %}
                                        {% when 'apple-music' %}
                                            {% render 'icon-apple-music' %}
                                        {% when 'facebook' %}
                                            {% render 'icon-facebook' %}
                                        {% when 'spotify' %}
                                            {% render 'icon-spotify' %}
                                        {% when 'youtube' %}
                                            {% render 'icon-youtube' %}
                                        {% when 'soundcloud' %}
                                            {% render 'icon-soundcloud' %}
                                        {% when 'amazon-music' %}
                                            {% render 'icon-amazon-music' %}
                                        {% when 'x-twitter' %}
                                            {% render 'icon-x-twitter' %}
                                    {% endcase %}
                                </a>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </div>
</section>

<!-- Email Signup Modal -->
