{% style %}

  [data-section-id="{{ section.id }}"] {
    background-color: {{ section.settings.bg_color }} !important;
    color: {{ section.settings.text_color }} !important;
    padding-top: {{ section.settings.padding_y_desktop }}px;
    padding-bottom: {{ section.settings.padding_y_desktop }}px;
  }

  @media screen and (max-width: 768px) {
    [data-section-id="{{ section.id }}"] {
      padding-top: {{ section.settings.padding_y_mobile }}px;
      padding-bottom: {{ section.settings.padding_y_mobile }}px;
    }
  }

  [data-section-id="{{ section.id }}"] .tour-date__info a {
    color: {{ section.settings.button_text_color }};
    background-color: {{ section.settings.button_bg_color }};
  }

{% endstyle %}

<section data-section-id="{{ section.id }}" class="section tour-dates" {% if section.settings.section_anchor_id %} id="{{ section.settings.section_anchor_id }}" {% endif %}>
    {% if section.settings.header %}
        <h2>{{ section.settings.header }}</h2>
    {% endif %}
    {% if section.blocks.size > 0 %}
        <div class="tour-dates__container">
            {% for block in section.blocks %}
                <div class="tour-date__info">
                    <time class="tour-date__date" datetime="{{ block.settings.date_iso }}">{{ block.settings.date }}</time>
                    <p class="tour-date__venue-name">{{ block.settings.venue_name }}</p>
                    <p class="tour-date__city">{{ block.settings.city }}</p>
                    <a href="{{ block.settings.url }}" class="faouzia-button" target="_blank">{{ section.settings.ticket_link_text }}</a>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</section>

{% schema %}
{
    "name": "Tour Dates",
    "enabled_on": {
        "templates": ["product", "collection", "page", "index", "article", "blog", "404", "cart", "search"]
    },
    "settings": [
        {
            "type": "text",
            "id": "section_anchor_id",
            "label": "Section Anchor ID (optional)"
        },
        {
            "type": "color",
            "id": "bg_color",
            "label": "Background Color",
            "default": "#FFFFFF"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#FFFFFF"
        },
        {
            "type": "text",
            "id": "header",
            "label": "Header"
        },
        {
            "type": "text",
            "id": "ticket_link_text",
            "label": "Ticket Link Text",
            "default": "Tickets"
        },
        {
            "type": "color",
            "id": "button_text_color",
            "label": "Button Text Color",
            "default": "#000000"
        },
        {
            "type": "color",
            "id": "button_bg_color",
            "label": "Button Background Color",
            "default": "#FFFFFF"
        },
        {
            "type": "range",
            "id": "padding_y_desktop",
            "label": "Desktop Padding Y (px)",
            "min": 0,
            "max": 200,
            "step": 4,
            "unit": "px",
            "default": 40
        },
        {
            "type": "range",
            "id": "padding_y_mobile",
            "label": "Mobile Padding Y (px)",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "default": 20
        }
    ],
    "blocks": [
    {
        "type": "tour_date",
        "name": "Tour Date",
        "settings": [
            {
                "type": "text",
                "id": "date",
                "label": "Date (Display)",
                "default": "January 01, 2026"
            },
            {
                "type": "text",
                "id": "date_iso",
                "label": "Date (ISO format for SEO, e.g. 2026-01-01)",
                "default": "2026-01-01"
            },
            {
                "type": "text",
                "id": "venue_name",
                "label": "Venue Name",
                "default": "Hammerstein Ballroom"
            },
            {
                "type": "text",
                "id": "city",
                "label": "City",
                "default": "New York, NY"
            },
            {
                "type": "url",
                "id": "url",
                "label": "Ticket URL"
            }
        ]
    }
    ],
    "presets": [
        {
            "name": "Tour Dates"
        }
    ]
}
{% endschema %}