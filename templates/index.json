        "custom_html": "<style>\n\n    /* Custom Content Hero Override */\n    .custom-content {\n        display: flex;\n        flex-direction: column;\n        align-items: center;\n        width: 100%;\n        height: 100%;\n        padding: 1% 3%;\n        position: relative;\n        justify-content: center;\n    }\n    \n     .custom-content .col {\n        flex: 1;\n     }\n\n    .custom-content__logo {\n        position: absolute;\n        top: 0%;\n        left: 50%;\n        transform: translateX(-50%);\n        width: 100%;\n        max-width: 15%;\n        display: block;\n    }\n\n    .custom-content__images {\n        display: flex;\n        flex-direction: row;\n        justify-content: space-between;\n        align-items: center;\n        width: 100%;\n    }\n\n    .custom-content__img-right-group {\n        display: flex;\n        flex-direction: column;\n        align-items: end;\n        width: fit-content;\n    }\n\n    .custom-content__img-right-group img,\n    .custom-content__images > img {\n        display: block;\n        max-width: 100%;\n    }\n\n    .custom-content__listen {\n        text-align: center;\n        text-decoration: none;\n    }\n\n    .custom-content__listen.desktop-only {\n        display: flex;\n        font-size: 40px;\n    }\n\n    .custom-content__listen.mobile-only {\n        display: none;\n        font-size: 30px;\n    }\n\n    /* Listen Now breakpoints — anchored at 40px @ 1340px */\n    @media screen and (min-width: 1440px) {\n        .custom-content__listen { font-size: 48px; }\n    }\n\n    @media screen and (min-width: 1280px) and (max-width: 1439px) {\n        .custom-content__listen { font-size: 40px; }\n    }\n\n    @media screen and (min-width: 1024px) and (max-width: 1279px) {\n        .custom-content__listen { font-size: 32px; }\n    }\n\n    @media screen and (min-width: 992px) and (max-width: 1023px) {\n        .custom-content__listen { font-size: 26px; }\n    }\n\n    @media screen and (min-width: 562px) and (max-width: 991px) {\n        .custom-content__listen { font-size: 22px; }\n    }\n\n    @media screen and (max-width: 561px) {\n        .custom-content__listen { font-size: 18px; }\n    }\n\n    .custom-content__images img {\n        width: 100%;   \n    }\n\n    .custom-content__img-right-group {\n        position: relative;\n    }\n\n    .custom-content__img-right-group a {\n        position: absolute;\n        bottom: -30%;\n        right: 0;\n    }\n\n    @media screen and (max-width: 769px) {\n        .custom-content__logo {\n            max-width: 130px;\n        }\n\n        .custom-content__listen.desktop-only {\n            display: none;\n        }\n\n        .custom-content__listen.mobile-only {\n            display: flex;\n        }\n    }\n\n</style>\n\n<div class=\"custom-content section\">\n\n    <img class=\"custom-content__logo\" src=\"https://cdn.shopify.com/s/files/1/0976/0967/9218/files/faouzia-white-logo-high-res-cropped.png?v=1778740413\" alt=\"Faouzia Logo\">\n        <div class=\"custom-content__images\">\n            <div class=\"col\">\n                <img class=\"custom-content__img-left\" src=\"https://cdn.shopify.com/s/files/1/0976/0967/9218/files/Image_2_2x_51bfcbac-2a90-4441-ac4c-59f6a5b85755.png?v=1778180916\" alt=\"\">\n            </div>\n            <div class=\"col\"></div>\n            <div class=\"col\">\n                <div class=\"custom-content__img-right-group\">\n                    <img class=\"custom-content__img-right\" src=\"https://cdn.shopify.com/s/files/1/0976/0967/9218/files/Image_3_2x_8e81e460-d384-4bb6-a382-f59f92f3681d.png?v=1778180967\" alt=\"\">\n                    <a class=\"custom-content__listen desktop-only\" href=\"https://stem.ffm.to/filmnoir\">Listen Now</a>\n                </div>\n            </div>\n        </div>\n    <a class=\"custom-content__listen mobile-only\" href=\"https://stem.ffm.to/filmnoir\">Listen Now</a>\n</div>",
